#OpenAI Key
OPENAI_API_KEY=your_openai_api_key
# Neon Postgres Database Connection String
# Get this from your Neon Console (https://console.neon.tech)
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth Configuration (Managed Better Auth)
# Required on Vercel deployment and local development
NEON_AUTH_BASE_URL=https://ep-damp-snow-b5y6ydzx.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=your_32_character_random_secret_here

# Neon Object Storage Configuration (S3-Compatible)
# Automatically pulled via: npx neon env pull -s object-storage
AWS_ACCESS_KEY_ID=nak_live_example
AWS_SECRET_ACCESS_KEY=example_secret_key
AWS_ENDPOINT_URL_S3=https://ep-example.storage.c-7.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=photoss


# Neon Realtime Configuration (Postgres Live Queries)
# Required for real-time memory board stream updates
NEON_REALTIME_URL=https://ep-example.rt.c-7.us-east-2.aws.neon.tech/
NEON_REALTIME_SECRET=nrt_live_example_secret
NEXT_PUBLIC_NEON_REALTIME_URL=https://ep-example.rt.c-7.us-east-2.aws.neon.tech/

# Optional: Emergency Admin Emails (comma-separated)
# Automatically elevates these Google accounts to Admin on first login
ADMIN_EMAILS=admin@example.com
